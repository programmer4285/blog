---
function getAriaCurrent(
  path: string,
): astroHTML.JSX.AriaAttributes["aria-current"] {
  return path === Astro.url.pathname ? "page" : undefined;
}
---

<header>
  <nav class="container">
    <ul>
      <li><a href="/" aria-current={getAriaCurrent("/")}>Home</a></li>
    </ul>
    <ul>
      <li>
        <a href="/posts" aria-current={getAriaCurrent("/posts")}>Posts</a>
      </li>
      <li>
        <a href="/tags" aria-current={getAriaCurrent("/tags")}>Tags</a>
      </li>
    </ul>
  </nav>
</header>
